# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/gymsaas?schema=public"

# Auth
AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars-long"

# Platform Branding
PLATFORM_NAME="FITCORE"
PLATFORM_LOGO_URL=""
PLATFORM_FAVICON_URL=""
PLATFORM_PRIMARY_COLOR="#111827"
PLATFORM_ACCENT_COLOR="#22C55E"
PLATFORM_SUPPORT_EMAIL="support@fitcore.com"
PLATFORM_SUPPORT_PHONE="+1-555-0000"

# Email (optional - for notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM="noreply@fitcore.com"

# File Storage (optional - for production)
# AWS_S3_BUCKET="your-bucket"
# AWS_S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# Feature Flags
ENABLE_WORKOUT_PLANS="true"
ENABLE_LEADS="true"
ENABLE_CLASSES="true"
ENABLE_PUBLIC_PAGES="true"
ENABLE_MULTI_BRANCH="false"
ENABLE_QR_CHECKIN="true"

# Default Settings
DEFAULT_TRIAL_DAYS="7"
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="UTC"
MAINTENANCE_MODE="false"

# Rate Limiting
RATE_LIMIT_LOGIN="5"
RATE_LIMIT_WINDOW_MS="900000"